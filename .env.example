# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Database ---
# Local dev (default): start a local Postgres with `bun run db:up`, then
# `bun run db:push && bun run db:seed`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/padel
#
# Production: use a Neon pooled connection string. Set this in the Vercel
# project's environment variables (NOT here). It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Better Auth ---
# Secret used to sign sessions/cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (used for auth callbacks). Local dev default below.
BETTER_AUTH_URL=http://localhost:3003

# --- REST API ---
# Bearer token for the public REST API (e.g. /api/clubs). Server-to-server
# callers send `Authorization: Bearer <ADMIN_API_KEY>`. Leave empty to disable
# token auth (logged-in super-admin sessions still work). Generate one with:
#   openssl rand -base64 32
ADMIN_API_KEY=

# --- AI Assistant ---
# Vercel AI Gateway key powering the AI assistant (/assistant). One key gives
# access to many models. Get one at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# Optional: override the model (defaults to a cheap tool-calling model,
# openai/gpt-5-nano). Any AI Gateway model id works, e.g. openai/gpt-4o-mini,
# google/gemini-2.5-flash-lite, amazon/nova-lite, anthropic/claude-haiku-4.5.
AI_MODEL=
# Optional but recommended: HMAC secret to cryptographically bind AI write
# approvals to the server that issued them. Generate one with:
#   openssl rand -base64 32
TOOL_APPROVAL_SECRET=
